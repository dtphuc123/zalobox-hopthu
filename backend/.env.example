# Sao chép file này thành ".env" rồi điền giá trị thật — KHÔNG commit file .env
# thật lên Git (đã có trong .gitignore). Đây chỉ là mẫu liệt kê các biến môi
# trường mà backend cần để chạy.

# ===== Database (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=zalobox_hopthu

# ===== Xác thực (JWT) =====
# Chuỗi bí mật dùng để ký/xác thực JWT. Đặt một chuỗi dài, ngẫu nhiên, không
# chia sẻ công khai — tuyệt đối không dùng giá trị mẫu này khi deploy thật.
JWT_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-trien-khai-that

# ===== Zalo (zca-js) =====
# Đường dẫn file lưu phiên đăng nhập Zalo (cookie/imei) sau khi quét QR, để
# không phải quét lại mỗi lần restart server.
ZALO_SESSION_PATH=./sessions/zalo-session.json

# ===== Server =====
PORT=3000
